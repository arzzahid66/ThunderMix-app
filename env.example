# Environment template. Copy to .env.local for local development
# (and rename this file to .env.example if you prefer the conventional name).
# Never commit real values.

# ── Runtime (required) ──────────────────────────────────────────────────────
# Neon *pooled* connection string (host contains "-pooler").
# Recommended for production: use the restricted tp_app login printed by
# `npm run db:app-role` instead of the owner (see README → Security hardening).
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=verify-full

# Max connections per server instance (keep small on serverless).
# DATABASE_POOL_MAX=5

# ── Tooling only (migrations, admin CLI) ────────────────────────────────────
# Neon *direct* (unpooled) owner connection. Not needed by the deployed app.
DATABASE_URL_UNPOOLED=postgresql://neondb_owner:PASSWORD@ep-xxxx.REGION.aws.neon.tech/neondb?sslmode=verify-full

# ── Tests only ──────────────────────────────────────────────────────────────
# Throwaway local Postgres for `npm run test:integration` (the suite DROPS the
# schema, and refuses to run against *.neon.tech). Default shown.
# TEST_DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54329/terminal_portal_test

# ── Live XMR price (visitor wallet) ─────────────────────────────────────────
# CoinMarketCap API key (https://pro.coinmarketcap.com). Falls back to the
# public CoinGecko API when missing or out of quota.
COINMARKETCAP_API_KEY=your-coinmarketcap-api-key
# Seconds between upstream price calls, shared by all visitors (default 60).
# The free CMC plan allows ~10k calls/month; 10 is fine on a paid plan.
# CMC_CACHE_SECONDS=60
