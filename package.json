{
  "name": "terminal-portal",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "db:migrate": "node --env-file-if-exists=.env.local scripts/migrate.mjs",
    "admin:create": "node --env-file-if-exists=.env.local scripts/create-admin.mjs",
    "db:app-role": "node --env-file-if-exists=.env.local scripts/create-app-role.mjs",
    "db:test:start": "docker run -d --name tp-postgres-test -e POSTGRES_PASSWORD=postgres -e POSTGRES_DB=terminal_portal_test -p 54329:5432 postgres:18-alpine"
  },
  "dependencies": {
    "lucide-react": "^1.48.0",
    "next": "16.3.6",
    "pg": "^8.23.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^22.20.4",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.6",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^5.0.1"
  },
  "engines": {
    "node": ">=20.9.0"
  }
}
